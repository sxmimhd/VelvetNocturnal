  m_Script: {fileID: 11500000, guid: 3bc7e21d279e2794da532ab820f58e27, type: 3}
  m_Name: invitation
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  speakerName: Lumy
  portrait: {fileID: -6028344193123754203, guid: 3eccbad8c3f48a34293959d573c085dc, type: 3}
  lines:
  - ...Hm? The envelope...
  - This is the address... I guess I really came all this way.
  - '"To Miss Lumy."'
  - '"If these words have reached you...

    then I have little time left."'
  - '"Your family has guarded a truth for generations.

    It was never meant to
    become your burden."'
  - '"Yet fate has chosen otherwise."'
  - Come to the House of Nocturnal."
  - '"Trust no voice within these walls.

    Follow only the fragments I have left
    behind."'
  - '"I will be waiting..."'
  - ...My family?
  - I've never heard of a place called Nocturnal...
  - ...I have to know why she called me.
  - ...There's only one way to find out.
  voices: []
